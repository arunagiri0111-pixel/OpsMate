# OpsMate ERP — Required Environment Variables
# Copy this file to .env and fill in your Firebase project values.
# In Vercel: add these as Environment Variables in the project dashboard.
# NEVER commit .env or config.js to version control.

FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
