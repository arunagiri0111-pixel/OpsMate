rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ──────────────────────────────────────────────
    // Each authenticated user can only read/write their own profile doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // All per-user data collections (sales, products, customers, etc.)
      // live as sub-collections under the user's own document.
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Tenant / multi-business data ───────────────────────────────
    // Tenants are identified by bizId. Only members of that tenant can
    // read or write tenant-level data.
    match /tenants/{bizId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/tenants/$(bizId)/members/$(request.auth.uid));

      // All sub-collections (sales, purchases, expenses, employees, …)
      match /{collection}/{docId} {
        allow read, write: if request.auth != null &&
          exists(/databases/$(database)/documents/tenants/$(bizId)/members/$(request.auth.uid));
      }
    }

    // ── Deny everything else by default ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
